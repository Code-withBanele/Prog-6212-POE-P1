@model List<MyRaceViewModel>
@{ ViewData["Title"] = "My races"; }
<h1 class="fw-bold mb-1">My races</h1><p class="text-muted mb-4">Your enrolments, event status and recorded results.</p>
@if(!Model.Any()){<div class="card card-body"><p class="mb-2">You have not enrolled in an event yet.</p><a asp-controller="Events" asp-action="Index" class="btn btn-warning align-self-start">Find an event</a></div>}
<div class="row g-3">@foreach(var race in Model){<div class="col-md-6"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="d-flex justify-content-between"><span class="badge @(race.Status == "Completed" ? "text-bg-success" : "text-bg-primary")">@race.Status</span><span class="text-muted small">@race.EventType · @race.DistanceKm km</span></div><h2 class="h5 fw-bold mt-3">@race.EventName</h2><p class="text-muted small">@race.EventDate.ToString("dd MMM yyyy") · @race.Location</p><p class="small mb-1"><strong>Category:</strong> @race.CategoryName</p>@if(race.Status == "Completed"){<p class="small mb-0"><strong>Finish:</strong> @race.FinishTime?.ToString("HH:mm:ss") · Position @race.FinishPosition</p>}else{<p class="small text-muted mb-0">Your result will appear here after the organiser records it.</p>}</div></div></div>}</div>
