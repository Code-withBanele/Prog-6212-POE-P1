@model List<MyRaceViewModel>
@{
    ViewData["Title"] = "My races";
}
<div class="mb-4">
    <p class="text-warning fw-bold text-uppercase mb-1">Your RaceDay activity</p>
    <h1 class="fw-bold mb-1">My races</h1>
    <p class="text-muted mb-0">Your enrolments, event status and recorded results.</p>
</div>

@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-warning">@error</div>
}
@if (!Model.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <p class="mb-2">You have not enrolled in an event yet.</p>
            <a asp-controller="Events" asp-action="Index" class="btn btn-warning">Find an event</a>
        </div>
    </div>
}
else
{
    <div class="row g-3">
    @foreach (var race in Model)
    {
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center gap-2">
                        <span class="badge @(race.Status == "Completed" ? "text-bg-success" : "text-bg-primary")">@race.Status</span>
                        <span class="text-muted small">@race.EventType · @race.DistanceKm km</span>
                    </div>
                    <h2 class="h5 fw-bold mt-3">@race.EventName</h2>
                    <p class="text-muted small">@race.EventDate.ToString("dd MMM yyyy") · @race.Location</p>
                    <p class="small mb-2"><strong>Category:</strong> @race.CategoryName</p>
                    @if (race.Status == "Completed")
                    {
                        <div class="rounded bg-light p-3">
                            <p class="small text-muted mb-1">Recorded finish time</p>
                            <p class="fs-4 fw-bold mb-2">@(race.FinishTime?.ToString("HH:mm:ss") ?? "—")</p>
                            @if (race.FinishPositionSummary is not null)
                            {
                                <p class="mb-0"><strong>Finishing position:</strong> @race.FinishPositionSummary</p>
                            }
                            else
                            {
                                <p class="small text-muted mb-0">Your finish position has not been published yet.</p>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="small text-muted mb-0">Your result will appear here after the organiser records it.</p>
                    }
                </div>
            </div>
        </div>
    }
    </div>
}
