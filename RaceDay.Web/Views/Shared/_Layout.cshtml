<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] - RaceDay</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark"><div class="container"><a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">RACEDAY<span class="text-warning">.</span></a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="mainNav"><ul class="navbar-nav me-auto">@if(User.IsInRole("Participant")){<li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Index">Find events</a></li>}@if(User.IsInRole("Organiser")){<li class="nav-item"><a class="nav-link" href="#">Organiser dashboard</a></li>}</ul><div class="d-flex gap-2 align-items-center">@if(User.Identity?.IsAuthenticated == true){<span class="text-light small">@User.Identity.Name</span><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-light btn-sm">Sign out</button></form>}else{<a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Sign in</a><a class="btn btn-warning btn-sm" asp-controller="Account" asp-action="Register">Join RaceDay</a>}</div></div></div></nav>
<main class="container py-4">@if(TempData["StatusMessage"] is string message){<div class="alert alert-success">@message</div>}@if(TempData["ErrorMessage"] is string errorMessage){<div class="alert alert-warning">@errorMessage</div>}@RenderBody()</main><footer class="container border-top py-3 text-muted small">RaceDay · Every finish line starts somewhere.</footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts", required:false)</body></html>
