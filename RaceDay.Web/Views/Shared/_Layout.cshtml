<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#141820" />
    <title>@ViewData["Title"] · RaceDay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark sticky-top">
    <div class="container">
        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">RACEDAY<span class="text-warning">.</span></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto ms-lg-4">
                @if (User.IsInRole("Participant"))
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Index">Discover events</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyRaces">My races</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Profile">Profile</a></li>
                }
                @if (User.IsInRole("Organiser"))
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Index">Dashboard</a></li>
                }
            </ul>
            <div class="d-flex flex-column flex-lg-row gap-2 align-items-lg-center py-3 py-lg-0">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="text-white-50 small me-lg-2">@User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button class="btn btn-outline-light btn-sm w-100" type="submit">Sign out</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-link text-white text-decoration-none btn-sm" asp-controller="Account" asp-action="Login">Sign in</a>
                    <a class="btn btn-warning btn-sm" asp-controller="Account" asp-action="Register">Create account <span aria-hidden="true">↗</span></a>
                }
            </div>
        </div>
    </div>
</nav>
<main class="container">
    @if (TempData["StatusMessage"] is string message)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @message
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @success
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @RenderBody()
</main>
<footer class="container border-top py-4 d-flex flex-column flex-sm-row justify-content-between gap-2 small">
    <span>© @DateTime.Now.Year RaceDay</span>
    <span>Every finish line starts somewhere.</span>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
