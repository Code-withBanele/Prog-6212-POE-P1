@model OrganiserEventViewModel
@{ ViewData["Title"] = "Edit event"; }
<div class="mb-4"><a asp-action="Index">← Dashboard</a><h1 class="fw-bold mt-3">Edit event</h1></div>
<div class="card border-0 shadow-sm"><div class="card-body p-4">
<form asp-action="Edit" asp-route-id="@ViewBag.EventId" method="post">
@Html.AntiForgeryToken()
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="row g-3">
<div class="col-md-8"><label asp-for="EventName" class="form-label"></label><input asp-for="EventName" class="form-control" /><span asp-validation-for="EventName" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="EventType" class="form-label"></label><select asp-for="EventType" class="form-select"><option>Run</option><option>Walk</option><option>Cycle</option></select></div>
<div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="EventDate" class="form-label"></label><input asp-for="EventDate" type="datetime-local" class="form-control" /><span asp-validation-for="EventDate" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control" /></div>
<div class="col-md-4"><label asp-for="DistanceKm" class="form-label"></label><input asp-for="DistanceKm" type="number" min="0.1" max="1000" step="0.1" class="form-control" /></div>
<div class="col-md-8"><label asp-for="CategoriesId" class="form-label">Participant category</label><select asp-for="CategoriesId" class="form-select"><option value="">Choose category</option>@foreach(var category in Model.Categories){<option value="@category.CategoriesId">@category.Name — @category.Description</option>}</select></div>
<div class="col-12"><label asp-for="RouteId" class="form-label">Race route</label><select asp-for="RouteId" class="form-select"><option value="">Choose route</option>@foreach(var route in Model.Routes){<option value="@route.RouteId">@route.RouteName — @route.StartLocation to @route.EndLocation</option>}</select></div>
</div>
<div class="d-flex gap-2 mt-4"><button class="btn btn-warning fw-bold" type="submit">Save changes</button><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div>
</form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }