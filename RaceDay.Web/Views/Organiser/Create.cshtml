@model OrganiserEventViewModel
@{ ViewData["Title"] = "Create event"; }
<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none">← Dashboard</a>
    <p class="text-warning fw-bold text-uppercase mt-3 mb-1">Race operations</p>
    <h1 class="fw-bold">Create an event</h1>
    <p class="text-muted">Publish a race or activity for participants to discover.</p>
</div>
<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="EventName" class="form-label">Event name</label>
                    <input asp-for="EventName" class="form-control" />
                    <span asp-validation-for="EventName" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="EventType" class="form-label">Activity</label>
                    <select asp-for="EventType" class="form-select">
                        <option>Run</option><option>Walk</option><option>Cycle</option>
                    </select>
                    <span asp-validation-for="EventType" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="EventDate" class="form-label">Date and time</label>
                    <input asp-for="EventDate" type="datetime-local" class="form-control" />
                    <span asp-validation-for="EventDate" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location" class="form-control" />
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="DistanceKm" class="form-label">Distance (km)</label>
                    <input asp-for="DistanceKm" type="number" min="0.1" max="1000" step="0.1" class="form-control" />
                    <span asp-validation-for="DistanceKm" class="text-danger"></span>
                </div>
                <div class="col-md-8">
                    <label asp-for="CategoriesId" class="form-label">Participant category</label>
                    <select asp-for="CategoriesId" class="form-select">
                        <option value="">Choose a category</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.CategoriesId">@category.Name — @category.Description</option>
                        }
                    </select>
                    <span asp-validation-for="CategoriesId" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="RouteId" class="form-label">Race route</label>
                    <select asp-for="RouteId" class="form-select">
                        <option value="">Choose an existing route</option>
                        @foreach (var route in Model.Routes)
                        {
                            <option value="@route.RouteId">@route.RouteName — @route.StartLocation to @route.EndLocation (@route.Duration min)</option>
                        }
                    </select>
                    <span asp-validation-for="RouteId" class="text-danger"></span>
                    <div class="form-text">Choose a saved route or create a new one.</div>
                    <a asp-action="CreateRoute" class="btn btn-sm btn-outline-secondary mt-2">+ Create a route</a>
                </div>
            </div>
            <div class="alert alert-light border mt-3 mb-0">
                <strong>Team allocation:</strong> This version of the API does not yet have a Team entity or team-management endpoint. The event will be saved as <code>OPEN</code> (unassigned), rather than requiring an invented team ID.
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-warning fw-bold" disabled="@(Model.Categories.Count == 0 || Model.Routes.Count == 0)">Create event</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
