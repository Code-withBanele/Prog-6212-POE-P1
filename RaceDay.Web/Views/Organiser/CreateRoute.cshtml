@model CreateRouteViewModel
@{ ViewData["Title"] = "Create route"; }
<div class="mb-4">
    <a asp-action="Create" class="text-decoration-none">← Back to event</a>
    <p class="text-warning fw-bold text-uppercase mt-3 mb-1">Race setup</p>
    <h1 class="fw-bold">Create a route</h1>
    <p class="text-muted">Save a route once, then select it for an event.</p>
</div>
<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form asp-action="CreateRoute" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="RouteName" class="form-label">Route name</label>
                    <input asp-for="RouteName" class="form-control" />
                    <span asp-validation-for="RouteName" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Duration" class="form-label">Estimated duration (minutes)</label>
                    <input asp-for="Duration" type="number" min="1" max="10000" class="form-control" />
                    <span asp-validation-for="Duration" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="StartLocation" class="form-label">Start location</label>
                    <input asp-for="StartLocation" class="form-control" />
                    <span asp-validation-for="StartLocation" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="EndLocation" class="form-label">Finish location</label>
                    <input asp-for="EndLocation" class="form-control" />
                    <span asp-validation-for="EndLocation" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-warning fw-bold">Save route</button>
                <a asp-action="Create" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
