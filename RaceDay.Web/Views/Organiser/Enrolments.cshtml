@model OrganiserEnrolmentsPageViewModel
@{ ViewData["Title"] = "Event enrolments"; }
<div class="mb-4"><a asp-action="Index">← Dashboard</a><p class="text-warning fw-bold text-uppercase mt-3 mb-1">Race operations</p><h1 class="fw-bold">@Model.Event.EventName</h1><p class="text-muted">Enrolments and finish results · @Model.Enrolments.Count participants</p></div>
@if(!Model.Enrolments.Any()){<div class="alert alert-light border">No participants have enrolled in this event yet.</div>}
<div class="table-responsive"><table class="table align-middle bg-white"><thead><tr><th>Participant</th><th>Category</th><th>Finish time</th><th>Position</th><th></th></tr></thead><tbody>
@foreach(var row in Model.Enrolments){<tr><td><strong>@row.ParticipantName</strong><div class="small text-muted">@row.ParticipantsId</div></td><td>@row.CategoryName</td><td colspan="3"><form asp-action="SaveResult" method="post" class="row g-2 align-items-center"><input type="hidden" name="id" value="@Model.Event.EventsId" /><input type="hidden" name="resultId" value="@row.ResultsId" /><div class="col-md-4"><input class="form-control form-control-sm" type="datetime-local" name="finishTime" value="@(row.FinishTime?.ToString("yyyy-MM-ddTHH:mm"))" aria-label="Finish time" /></div><div class="col-md-3"><input class="form-control form-control-sm" type="number" min="1" name="finishPosition" value="@row.FinishPosition" placeholder="Position" aria-label="Finish position" /></div><div class="col-md-3"><button class="btn btn-sm btn-warning" type="submit">Save result</button></div></form></td></tr>}
</tbody></table></div>