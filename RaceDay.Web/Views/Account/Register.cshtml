@model RegisterViewModel
@{
    ViewData["Title"] = "Create account";
}
<div class="row justify-content-center py-lg-4">
    <div class="col-lg-9 col-xl-8">
        <div class="row g-0 bg-white rounded-4 overflow-hidden shadow-sm border">
            <div class="col-md-5 d-none d-md-flex flex-column justify-content-between p-4 p-lg-5 text-white" style="background:linear-gradient(145deg,#171c25,#343d4b)">
                <div>
                    <span class="text-warning fw-bold small text-uppercase">Join the community</span>
                    <h1 class="display-5 fw-bold mt-4">Make your next move count.</h1>
                    <p class="text-white-50 mt-3">Create your RaceDay account and get closer to your next finish line.</p>
                </div>
                <div class="small text-white-50">RACEDAY<span class="text-warning">.</span> · PLAN / PARTICIPATE / PERFORM</div>
            </div>
            <div class="col-md-7 p-4 p-lg-5">
                <span class="text-warning fw-bold small text-uppercase">Create your account</span>
                <h2 class="h3 fw-bold mt-2">Let's get you started.</h2>
                <p class="text-muted mb-4">Choose how you'll use RaceDay. You can sign in once your account is created.</p>
                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label asp-for="Name" class="form-label">First name</label>
                            <input asp-for="Name" class="form-control" autocomplete="given-name" placeholder="Your first name" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Surname" class="form-label">Surname</label>
                            <input asp-for="Surname" class="form-control" autocomplete="family-name" placeholder="Your surname" />
                            <span asp-validation-for="Surname" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Email" class="form-label">Email address</label>
                            <input asp-for="Email" class="form-control" autocomplete="email" placeholder="you@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Role" class="form-label">I want to join as a</label>
                            <select asp-for="Role" class="form-select" id="accountRole">
                                <option value="Participant">Participant — discover and enter events</option>
                                <option value="Organiser">Organiser — create and manage events</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6" id="ageField">
                            <label asp-for="Age" class="form-label">Age</label>
                            <input asp-for="Age" class="form-control" type="number" min="1" max="120" placeholder="Your age" />
                            <span asp-validation-for="Age" class="text-danger small"></span>
                            <div class="form-text">Required for participant accounts.</div>
                        </div>
                        <div class="col-sm-6" id="genderField">
                            <label asp-for="Gender" class="form-label">Gender</label>
                            <select asp-for="Gender" class="form-select">
                                <option value="O">Prefer not to say</option>
                                <option value="F">Female</option>
                                <option value="M">Male</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label asp-for="Password" class="form-label">Password</label>
                            <input asp-for="Password" class="form-control" autocomplete="new-password" placeholder="At least 8 characters" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="ConfirmPassword" class="form-label">Confirm password</label>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Enter your password again" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                        <div class="col-12 pt-2">
                            <button type="submit" class="btn btn-warning btn-lg w-100">Create my account <span aria-hidden="true">↗</span></button>
                        </div>
                    </div>
                </form>
                <p class="small text-muted mt-4 mb-0">Already have an account? <a asp-action="Login" class="fw-bold">Sign in</a></p>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const role = document.getElementById('accountRole');
            const ageField = document.getElementById('ageField');
            const ageInput = document.getElementById('Age');
            const syncRoleFields = () => {
                const participant = role.value === 'Participant';
                ageField.hidden = !participant;
                ageInput.required = participant;
                if (!participant) ageInput.value = '';
            };
            role.addEventListener('change', syncRoleFields);
            syncRoleFields();
        })();
    </script>
}
