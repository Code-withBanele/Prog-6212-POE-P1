@{ ViewData["Title"] = "Home"; }
<section class="hero-panel p-5 rounded-4 text-white"><p class="text-warning fw-bold text-uppercase">Plan. Participate. Perform.</p><h1 class="display-3 fw-bold">Your next finish line<br/>starts here.</h1><p class="lead">Discover events, manage race day operations and track every result with RaceDay.</p>@if(User.Identity?.IsAuthenticated != true){<a class="btn btn-warning btn-lg fw-bold me-2" asp-controller="Account" asp-action="Register">Get started</a><a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Login">Sign in</a>}else{<p>Signed in as <strong>@User.Identity.Name</strong>. Role: @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</p>}</section>
