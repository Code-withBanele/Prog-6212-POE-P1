# Copy this file to .env and replace every placeholder before starting Docker.
# Use a strong SQL Server password (at least 8 characters, mixed case,
# a number and a symbol). Avoid semicolons in the password.
SA_PASSWORD=Replace_With_A_Strong_Sql_Password_123!
JWT_SECRET=Replace_With_A_Random_32_Byte_Base64_Secret
# Optional: configure this to enable event banner and profile image uploads.
AZURE_BLOB_STORAGE_CONNECTION_STRING=
