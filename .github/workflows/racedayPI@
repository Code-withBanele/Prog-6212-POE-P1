name: RaceDay API CI/CD

'on':
  push:
    branches:
      - main
      - part-2-api
  pull_request:
    branches:
      - main
      - part-2-api
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build-and-publish:
    name: Build and publish RaceDay API
    runs-on: ubuntu-latest

    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up .NET 10
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: 10.0.x

      - name: Restore dependencies
        run: dotnet restore RaceDay/RaceDay.csproj

      - name: Build API
        run: dotnet build RaceDay/RaceDay.csproj --configuration Release --no-restore

      # This repository currently has no separate automated test project.
      # Add a test project and a dotnet test step when tests are introduced.

      - name: Publish API
        if: ${{ github.event_name == 'push' }}
        run: dotnet publish RaceDay/RaceDay.csproj --configuration Release --no-restore --output ./publish

      - name: Upload published API artifact
        if: ${{ github.event_name == 'push' }}
        uses: actions/upload-artifact@v4
        with:
          name: RaceDay-api-${{ github.sha }}
          path: publish/
          if-no-files-found: error
          retention-days: 14
